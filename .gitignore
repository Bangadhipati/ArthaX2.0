.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js & Frontend
frontend/node_modules/
node_modules/
frontend/dist/
dist/
dist-ssr/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env

# Operating System & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Antigravity & AI Assistant Temp Storage
.tempmediaStorage/
.system_generated/
.gemini/
